{
  "name": "expression",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.ts",
    "test:build": "node --test tests/build/*.test.mjs",
    "verify": "npm run format:check && npm test && npm run build && npm run test:build && npm run test:fixture",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/*.mjs\" \"astro.config*.mjs\" \"tests/fixtures/*.json\" package.json \".github/workflows/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"tests/**/*.{ts,mjs}\" \"scripts/*.mjs\" \"astro.config*.mjs\" \"tests/fixtures/*.json\" package.json \".github/workflows/*.yml\"",
    "test:fixture": "node scripts/test-fixture-build.mjs"
  },
  "dependencies": {
    "@fontsource/playfair-display": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "chart.js": "^4.6.1",
    "cloudinary": "^2.11.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^6.1.5"
    }
  }
}
