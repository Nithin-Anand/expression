---
import type { InferGetStaticPropsType } from "astro";
import { getAlbums } from "../../data/content";
import { getAlbumPhotos } from "../../data/photos";
import { formatDate } from "../../lib/dates";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageContainer from "../../components/PageContainer.astro";
import PhotoGrid from "../../components/gallery/PhotoGrid.astro";
import Lightbox from "../../components/gallery/Lightbox.astro";

export async function getStaticPaths() {
  return (await getAlbums()).map((album) => ({ params: { id: album.id }, props: { album } }));
}
type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { album } = Astro.props;
const photos = await getAlbumPhotos(album.id);
const essayParagraphs =
  album.data.essay
    ?.split(/\n\s*\n/)
    .map((paragraph) => paragraph.trim())
    .filter(Boolean) ?? [];
---

<BaseLayout pageTitle={album.data.title} pageDescription={album.data.description} hideTitle>
  <article>
    <header class="mx-auto max-w-3xl px-4 pb-8 pt-10 text-center sm:pt-16">
      {album.data.showDate && (
        <p class="mb-4 text-xs font-medium uppercase tracking-[0.28em] text-neutral-500">
          <time datetime={album.data.date.toISOString()}>{formatDate(album.data.date, true)}</time>
        </p>
      )}
      <h1 class="text-4xl font-bold leading-tight text-neutral-800 sm:text-6xl">
        {album.data.title}
      </h1>
      {album.data.description && (
        <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-neutral-600 sm:text-xl">
          {album.data.description}
        </p>
      )}
      <p class="mt-5 text-xs uppercase tracking-[0.2em] text-neutral-500">
        {photos.length} {photos.length === 1 ? "photograph" : "photographs"}
      </p>
    </header>
    {essayParagraphs.length > 0 && (
      <div class="prose prose-neutral mx-auto max-w-2xl px-4 pb-8 sm:prose-lg">
        {essayParagraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    )}
    <PageContainer>
      <PhotoGrid photos={photos} title={album.data.title} showCaptions />
    </PageContainer>
    <footer class="my-12 text-center">
      <a
        href="/gallery/"
        class="text-sm uppercase tracking-[0.18em] text-neutral-500 hover:text-neutral-900"
      >
        View other albums
      </a>
    </footer>
  </article>
  <Lightbox />
</BaseLayout>
