---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import PhotoGrid from "../components/gallery/PhotoGrid.astro";
import Lightbox from "../components/gallery/Lightbox.astro";
import { getAlbumPhotos } from "../data/photos";

const photos = await getAlbumPhotos("portfolio");
---

<BaseLayout
  pageTitle="Minimally Processed"
  pageDescription="Photography by Nithin Anand."
  hideTitle
>
  <h1 class="sr-only">Minimally Processed</h1>
  <PageContainer>
    <PhotoGrid photos={photos} title="Portfolio" />
  </PageContainer>
  <Lightbox />
</BaseLayout>
