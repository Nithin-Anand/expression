---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import { Image } from "astro:assets";
import { getPublishedPosts } from "../data/content";
import { formatDate } from "../lib/dates";
const posts = await getPublishedPosts();
---

<BaseLayout
  pageTitle="Blog"
  pageDescription="Photo stories, camera impressions and lessons learned by Nithin Anand."
>
  <PageContainer>
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <a href={`/blog/${post.id}/`} class="group mb-4 block">
          {post.data.cover && (
            <Image
              src={post.data.cover}
              alt={post.data.title}
              format="avif"
              width={720}
              quality="mid"
              class="rounded-lg transition-all group-hover:opacity-90 group-hover:shadow-lg"
            />
          )}
          <h2 class="mt-4 text-lg font-semibold group-hover:underline">{post.data.title}</h2>
          <p class="text-sm text-neutral-700">{post.data.description}</p>
          <p class="mt-2 text-xs text-neutral-500">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
          </p>
        </a>
      ))}
    </div>
  </PageContainer>
</BaseLayout>
