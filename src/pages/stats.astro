---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageContainer from "../components/PageContainer.astro";
import StatsChart from "../components/stats/StatsChart.astro";
import RecentPhotos from "../components/stats/RecentPhotos.astro";
import { getStats } from "../data/stats";
import { getAlbums } from "../data/content";

const [stats, albums] = await Promise.all([getStats(), getAlbums()]);
const titles = Object.fromEntries(albums.map((album) => [`albums/${album.id}`, album.data.title]));
const albumLabels = Object.keys(stats.album_counts).map((folder) => titles[folder] ?? folder);
---

<BaseLayout pageTitle="Collection Stats" pageDescription="Fun stats about the photo collection.">
  <PageContainer size="medium">
    <div class="mb-12 grid gap-8 text-center md:grid-cols-2">
      <section>
        <h2 class="mb-4 text-2xl font-bold">Total Images in Collection</h2>
        <p class="font-serif text-5xl">{stats.total_count}</p>
      </section>
      <section>
        <h2 class="mb-4 text-2xl font-bold">Number of Featured Images</h2>
        <p class="font-serif text-5xl">{stats.portfolio_count}</p>
      </section>
    </div>
    <StatsChart
      title="Upload Timeline"
      kind="line"
      labels={stats.upload_timeline.map((day) => day.date)}
      values={stats.upload_timeline.map((day) => day.count)}
    />
    <RecentPhotos photos={stats.recently_added} />
    <StatsChart
      title="Total Images in Each Album"
      kind="doughnut"
      labels={albumLabels}
      values={Object.values(stats.album_counts)}
    />
  </PageContainer>
</BaseLayout>
