---
interface Props {
  size?: "wide" | "medium" | "reading";
  class?: string;
}
const { size = "wide", class: className } = Astro.props;
const widths = { wide: "max-w-7xl", medium: "max-w-4xl", reading: "max-w-3xl" };
---

<div class:list={["mx-auto w-full px-4 py-8 sm:px-6", widths[size], className]}>
  <slot />
</div>
