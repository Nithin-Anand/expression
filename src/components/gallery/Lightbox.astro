<dialog
  id="lightbox"
  aria-label="Photo viewer"
  class="m-0 h-full max-h-none w-full max-w-none overflow-hidden bg-transparent p-0 backdrop:bg-black/90"
>
  <div data-lightbox-content class="relative flex h-full w-full items-center justify-center">
    <button
      type="button"
      data-action="close"
      autofocus
      aria-label="Close lightbox"
      class="absolute right-4 top-4 z-10 rounded p-3 text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-white"
    >
      <svg
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>
    <button
      type="button"
      data-action="previous"
      aria-label="Previous photo"
      class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded bg-black/30 p-3 text-white focus-visible:outline-2 focus-visible:outline-white sm:left-4"
    >
      <svg
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="m15 18-6-6 6-6" />
      </svg>
    </button>
    <button
      type="button"
      data-action="next"
      aria-label="Next photo"
      class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded bg-black/30 p-3 text-white focus-visible:outline-2 focus-visible:outline-white sm:right-4"
    >
      <svg
        aria-hidden="true"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="m9 18 6-6-6-6" />
      </svg>
    </button>
    <img
      data-lightbox-image
      alt=""
      class="max-h-[85vh] max-w-[90vw] rounded-sm object-contain shadow-2xl"
    />
    <p
      data-lightbox-status
      aria-live="polite"
      aria-atomic="true"
      class="absolute bottom-4 left-1/2 -translate-x-1/2 text-sm text-white"
    ></p>
  </div>
</dialog>
<script>
  import { initLightbox } from "../../scripts/lightbox";
  const dialog = document.querySelector<HTMLDialogElement>("#lightbox");
  if (dialog) initLightbox(dialog);
</script>
