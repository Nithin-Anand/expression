---
import Navigation from "./Navigation.astro";

import logo from "../assets/logos/horizontal_serif.svg";
import smallLogo from "../assets/logos/square_no_tag_serif.svg";
---

<header class="flex justify-between items-center w-full px-8 py-4 sticky top-0 z-50 backdrop-blur-md bg-white/80 border-b border-neutral-100">
  <div class="logo">
    <a href="/" class="flex items-center">
      <img
        src={smallLogo.src}
        alt="Minimally Processed home"
        class="w-12 h-12 align-middle md:hidden"
      />
      <img
        src={logo.src}
        alt="Minimally Processed home"
        class="h-6 w-auto align-middle hidden md:block"
      />
    </a>
  </div>
  <Navigation />
</header>
